    def get_kb_access_token(self):
        """OAuth2 인증 토큰 발급 (24시간 유효 임시 입장권 수령)"""
        print("\n[KB API] 🔑 OAuth2 Access Token 발급 요청 중...", flush=True)
        url = f"{self.base_url}/oauth2/token"
        headers = {"Content-Type": "application/x-www-form-urlencoded"}
        data = {"grant_type": "client_credentials", "appkey": self.app_key, "appsecret": self.app_secret}

        try:
            response = requests.post(url, headers=headers, data=data, verify=False)
            if response.status_code == 200:
                self.access_token = response.json().get("access_token")
                print("[KB API] ✅ 실전 거래용 Access Token 동기화 성공.", flush=True)
                return True
            else:
                print(f"[KB API 오류] 토큰 발급 실패: {response.text}", flush=True)
                return False
        except Exception as e:
            print(f"[시스템 에러] KB 서버 통신망 장애: {e}", flush=True)
            return False

    def execute_kb_market_order(self, stock_code, qty, price, target_cash):
        """국내주식/ETF 시장가 신규 매수 주문 전송 인터페이스"""
        if not self.access_token:
            print("[KB API] 🚫 유효한 입장 토큰이 유실되어 주문을 거절합니다.", flush=True)
            return

        print(f"\n ├ 📐 [주문 수량 산정 연산 공식]: 목표 할당 금액({int(target_cash):,}원) ÷ 주당 실시간 현재가({price:,}원)", flush=True)
        print(f" │    👉 연산 결과 산출물: {int(target_cash)} / {price} = {qty}주 매수 계약 도출", flush=True)

        url = f"{self.base_url}/v1/trading/order"
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {self.access_token}",
            "appkey": self.app_key,
            "appsecret": self.app_secret,
            "tr_id": "TTTC0802U",
            "custtype": "P"
        }
        data = {
            "CANO": self.account_no,
            "ACNT_PRDT_CD": "01",
            "PDNO": stock_code,
            "ORD_DVSN": "01",
            "ORD_QTY": str(qty),
            "ORD_UNPR": "0",
        }

        if not self.config.get("ENABLE_REAL_TRADING", False):
            print(f" └ 🛡️  [안전 가상 샌드박스] ENABLE_REAL_TRADING=False 프로토콜 작동에 따라 실제 증권사 자본금 매수를 보류하고 모의 체결 처리합니다.", flush=True)
            return

        try:
            response = requests.post(url, headers=headers, data=json.dumps(data), verify=False)
            if response.status_code == 200:
                res_json = response.json()
                rt_cd = res_json.get("rt_cd")
                msg = res_json.get("msg1")
                if rt_cd in ["0", "0000"]:
                    print(f" └ 🎉 [주문 통신 체결 성공] 종목: {stock_code} | 수량: {qty}주 | 응답 메시지: {msg}", flush=True)
                else:
                    print(f" └ ❌ [증권사 거부 오류] 코드: {rt_cd} | 원인: {msg}", flush=True)
            else:
                print(f" └ ❌ [HTTP 서버 오류] 상태 코드: {response.status_code} | 내용: {response.text}", flush=True)
        except Exception as e:
            print(f" └ ❌ [통신 파괴 오류] 주문 전송 중 치명적 에러 발생: {e}", flush=True)

