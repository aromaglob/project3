# 🤖 [컴포넌트 4] 금융 특화 의식 분석 AI 엔진 클래스
# =========================================================================
class ConsciousnessIntelligence:

    def __init__(self, target_assets, config):
        """AI 모델 관리 및 고급 감성 지표 산출 분리 엔진"""
        print("\n[System] 🤖 금융 특화 의식 분석 AI(FinBERT) 독립 엔진 장착 중...", flush=True)
        self.target_assets, self.config = target_assets, config

        try:
            self.tokenizer = AutoTokenizer.from_pretrained("ProsusAI/finbert", clean_up_tokenization_spaces=True)
            self.model = AutoModelForSequenceClassification.from_pretrained("ProsusAI/finbert")
            self.use_real_ai = True
        except Exception as e:
            print(f" ⚠️ [AI 경고] 외부 HuggingFace 모델 연결 실패({e}). 안전 시뮬레이션 연산 모드로 가동합니다.", flush=True)
            self.use_real_ai = False

    def extract_net_sentiment(self, asset, text_list):
        """비정형 텍스트 스트림을 FinBERT로 파싱하여 -1.0 ~ +1.0 감성 점수 반환"""
        if not text_list:
            print(f" ⚠️ [{asset}] 수집된 의식 공유 텍스트 데이터가 비어 있습니다.", flush=True)
            return 0.0

        print(f"\n" + "-" * 50, flush=True)
        print(f"🔮 [의식 공유 데이터 전처리 정밀 로그: {asset}]", flush=True)
        print(f" ├ 🔤 입력 텍스트 스트림 개수: {len(text_list)}개 문장 집계 완료", flush=True)

        scores = []

        if self.use_real_ai:
            inputs = self.tokenizer(text_list, padding=True, truncation=True, return_tensors="pt")
            print(f" ├ 🔢 AI 인코딩 텐서 차원(Input Shape): {list(inputs['input_ids'].shape)} [Batch, Sequence Length]", flush=True)

            with torch.no_grad():
                outputs = self.model(**inputs)
                predictions = torch.nn.functional.softmax(outputs.logits, dim=-1)

            print(f" ├ 🧠 AI 신경망 원시 연산 분포 추적 (Softmax Probability Distribution)", flush=True)
            for i, pred in enumerate(predictions):
                # 🌟 [정밀 조립] 텐서 차원 다단계 분리 추출 완료
                pos_prob = pred[0].item()
                neg_prob = pred[1].item()
                neu_prob = pred[2].item()

                net_score = pos_prob - neg_prob
                scores.append(net_score)

                truncated_text = text_list[i][:60] + "..." if len(text_list[i]) > 60 else text_list[i]
                print(f" │   📁 문장 {i+1} : \"{truncated_text}\"", flush=True)
                print(f" │      ➡️ 확률 매트릭스  |  🟢 긍정: {pos_prob*100:5.1f}%  |  🔴 부정: {neg_prob*100:5.1f}%  |  ⚪ 중립: {neu_prob*100:5.1f}%", flush=True)
                print(f" │      ➡️ 넷 감성 스코어  |  [수식: 긍정({pos_prob:.4f}) - 부정({neg_prob:.4f})] = {net_score:+.4f}", flush=True)
        else:
            print(" ├ 🧠 [가상 시뮬레이션 모드] 로컬 난수 연산 분포 매핑 가동", flush=True)
            for i, text in enumerate(text_list):
                pos_prob, neg_prob, neu_prob = (0.65, 0.10, 0.25) if "우수" in text or "상회" in text or "출시" in text else (0.12, 0.68, 0.20)
                net_score = pos_prob - neg_prob
                scores.append(net_score)
                print(f" │   📁 문장 {i+1} : \"{text[:35]}...\"", flush=True)
                print(f" │      ➡️ 넷 감성 스코어  |  [수식: 긍정({pos_prob:.2f}) - 부정({neg_prob:.2f})] = {net_score:+.2f}", flush=True)

        final_consciousness_score = np.clip(float(np.mean(scores)), -1.0, 1.0)
        print(f" ├" + "─" * 48, flush=True)
        print(f" └ 📊 종합 의식 공유 센티먼트 결합 점수 (Asset Sentiment Score): {final_consciousness_score:+.4f}", flush=True)
        print("-" * 50, flush=True)
        return final_consciousness_score

    def get_tactical_tilting_factors(self, raw_streams, volatility):
        """자산별 의식 점수를 계산하고 리스크 기반 동적 틸팅 가중치 산출"""
        tilting_factors = {}
        threshold, alpha, default_mode = self.config["threshold"], self.config["intensity"], self.config["mode"]
        print("\n" + "=" * 95, flush=True)
        print("▶ [연산 과정 파트 1] AI 의식 공유 심층 분석 및 포트폴리오 전술적 틸팅(Tilt 팩터) 계산", flush=True)
        print("=" * 95, flush=True)

        for asset in self.target_assets:
            stream = raw_streams.get(asset, [])
            vol = volatility.get(asset, 0.1)
            score = self.extract_net_sentiment(asset, stream)

            print(f"🔍 [{asset} 전략 필터링 엔진 가동]", flush=True)
            print(f" ├ 🎛️ 노이즈 캔슬링 검증: AI 감성 절대값 |{score:.4f}| ↔️ 진입 제한 임계값 {threshold:.2f}", flush=True)

            if abs(score) < threshold:
                print(f" ⚠️  [필터링 기각] 대중의 의식이 임계점 미만으로 고요합니다. ➡️ 전술적 자산 변동 생략 (정적 배분 유지)", flush=True)
                tilting_factors[asset] = 0.0
                continue
            else:
                print(f" ✅ [필터링 통과] 유의미한 과열 또는 패닉 상태 감지. 전술적 자산배분 보정 단계 조립 진입", flush=True)

            current_mode = "contrarian" if abs(score) >= 0.85 else default_mode
            print(f" ├ 🔁 운용 매칭 프로필 모드: 기본 셋업({default_mode}) ➡️ 현재 융합 모드({current_mode})", flush=True)

            if abs(score) >= 0.85:
                print(f" │    🚨 [AI 위험 경고] 감성 수치가 극단적 한계점(0.85)을 돌파한 군집 광기 상태입니다! 리스크 가드 작동, 역발상(Contrarian) 강제 스위칭 수행", flush=True)

            direction = -1.0 if current_mode == "contrarian" else 1.0
            signal = score * direction
            vol_scaler = 1.0 / (vol + 1e-6)
            tilt = signal * alpha * (vol_scaler * 0.02)
            tilting_factors[asset] = tilt

            print(f" ├ 📐 리스크 스케일링 공식 모델링", flush=True)
            print(f" │    Formula : 방향성 시그널({signal:+.4f}) × 반영강도 계수({alpha}) × [자산 고유 변동성 역수({vol_scaler:.4f}) × 스케일상수(0.02)]", flush=True)
            print(f" └ 💡 [결과물 확정] {asset} 최종 자산 틸팅 가중치 가감값: {tilt:>+7.4f}", flush=True)

        return tilting_factors



